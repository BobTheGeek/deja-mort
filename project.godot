; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DÉJÀ MORT"
config/description="A die-and-retry room-survival puzzle game. You've died here before."
config/version="0.0.1"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/brand/app-icon-1024.png"

[autoload]

Brand="*res://game/theme/brand.gd"

[display]

; The UI is designed at 1920x1080 (docs/ui/SPEC.md) and the canvas stretches to
; it, so every number in visuals.json is literal at any window size. The window
; still opens at 1152x648; only the units change.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1152
window/size/window_height_override=648
window/handheld/orientation="landscape"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="deja-mort"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="gl_compatibility"
